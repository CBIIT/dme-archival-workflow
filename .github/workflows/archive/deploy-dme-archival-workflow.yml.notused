name: Deploy DME Archival Workflow jar file
permissions:
  contents: write
  id-token: write
  actions: read
on:
  workflow_dispatch:
    inputs:
      environment:
        description: env to deploy jar file
        required: true
        default: prod
      #code_branch:
        #description: branch to build
        #required: true
        #default: main
      fsdmel-wflow05p.ncifcrf.gov:
        description: deploy to wflow5p server
        type: boolean
        default: false

  workflow_run:
    workflows: ["build-dme-archival-workflow.yml"]
    types:
      - completed

run-name: "Deploy JARs for ${{ github.event.inputs.environment }}"
jobs:
  determine-targets:
    name: Determine target servers
    runs-on:
      group: cbiit-global-runners
      labels: [self-hosted]
    outputs:
      servers: ${{ steps.build-list.outputs.servers }}
    steps:
      - name: Build server list
        id: build-list
        run: |

  deploy:
    if: |
      github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
    runs-on:
      group: cbiit-global-runners
      labels: [self-hosted]
    environment: ${{ inputs.environment }}
    env:
      CODE_BRANCH: "${{ github.event.inputs.code_branch }}"
    steps:
      - name: Determine trigger source
        run: echo "Triggered by ${{ github.event_name }}"

      - name: Print inputs or workflow run data
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "Manual input: Environment = ${{ inputs.environment }}, Branch = ${{ inputs.code_branch }}"
          else
            echo "Triggered from workflow run #${{ github.event.workflow_run.run_number }}"
          fi

      - name: Download Artifacts
        uses: dawidd6/action-download-artifact@v6
        with:
          workflow: build-dme-archival-dashboard.yml 
          run_number: ${{ github.event.workflow_run.run_number || '' }}
          workflow_conclusion: success
          name: dme-archival-dashboard-artifacts
          path: ./artifacts
      - name: list downloaded artifacts
        run: |
          ls -R ./artifacts || echo "Artifacts not found!"

      - name: Set up SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.TOMCAT_SSH_KEY }}" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
          ssh-keyscan -H ${{ secrets.TOMCAT_HOST }} >> ~/.ssh/known_hosts
      - name: deploy tomcat
        env:
          remote_user: ${{ secrets.REMOTE_USER }}
          remote: ${{ secrets.TOMCAT_HOST }}
          dist: /var/lib/tomcat/webapps
          remote_tomcat: tomcat
          app: dme-workflow-dashboard
          unit: dme-workflow-dashboard.war
        run: |
          set -xe
          #ssh -o StrictHostKeyChecking=no ncif-hpcdm-svc@ncias-d3610-v "sudo /sbin/service $remote_tomcat stop"
          echo "Stopping tomcat"
          ssh -qt $remote_user@$remote "sudo systemctl stop $remote_tomcat"
          echo "Cleaning old backups and symlinks..."
          ssh -qt ${remote_user}@${remote} " umask 022; cd ${dist} && if [ -d ROOT ]; then rm -rf ROOT; fi ;  "
          ssh -qt ${remote_user}@${remote} " cd ${dist}; rm -f dme-workflow-dashboard-[0-9]*.war_backup* dme-workflow-dashboard-[0-9]*.war.backup* "
          ssh -qt ${remote_user}@${remote} " cd ${dist} && if [ -L ${unit} ]; then rm -f ${unit}; else echo "No symlink found"; fi ; "
          ssh -qt ${remote_user}@${remote} " export TZ='America/New_York'; cd ${dist}; find . -maxdepth 1 -type f -name ${app}-*.war -exec mv {} {}_backup_$(date +%Y%m%d.%H%M) \;" || exit $?
          echo "upoading wars to remote server"
          scp -pq artifacts/target/${app}-*.war ${remote_user}@${remote}:${dist}
          echo "creating symlink"
          ssh -qt ${remote_user}@${remote} " cd ${dist} && ln -s $app-*.war ${unit}"
          echo "restart tomcat"
          ssh -qt ${remote_user}@${remote} "sudo systemctl start $remote_tomcat"
