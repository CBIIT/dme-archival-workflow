name: Deploy DME Sync Jar

permissions:
  contents: read
  actions: read

on:
  workflow_dispatch:
    inputs:
      build_run_id:
        description: "GitHub Actions run ID of the build workflow to deploy"
        required: true
        type: string
      servers:
        description: "Comma-separated target servers (example: dev-app-01,dev-app-02)"
        required: true
        type: string
        default: "dev-app-01"

run-name: "Deploy DME Sync Jar (build run: ${{ github.event.inputs.build_run_id }})"

jobs:
  prepare:
    name: Prepare deployment matrix
    runs-on:
      group: cbiit-global-runners
      labels: [self-hosted]
    outputs:
      matrix: ${{ steps.matrix.outputs.matrix }}
    steps:
      - name: Build server matrix
        id: matrix
        shell: bash
        run: |
          set -euo pipefail

          servers='${{ github.event.inputs.servers }}'
          if [ -z "$servers" ]; then
            echo "servers input is required" >&2
            exit 1
          fi

          json='{"include":['
          first=1
          IFS=',' read -r -a server_list <<< "$servers"
          for server in "${server_list[@]}"; do
            server="$(echo "$server" | xargs)"
            [ -z "$server" ] && continue

            if [ "$first" -eq 0 ]; then
              json+=','
            fi
            first=0
            json+="{\"server\":\"$server\"}"
          done
          json+=']}'

          if [ "$first" -eq 1 ]; then
            echo "No valid servers were supplied" >&2
            exit 1
          fi

          echo "matrix=$json" >> "$GITHUB_OUTPUT"

  deploy:
    name: Deploy to ${{ matrix.server }}
    needs: prepare
    runs-on:
      group: cbiit-global-runners
      labels: [self-hosted]
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.prepare.outputs.matrix) }}
    env:
      APP_NAME: dme-sync
      SERVICE_NAME: archival-workflow
      DEPLOY_DIR: /opt/hpcdm_workflows/deployments
      SSH_USER: ${{ secrets.DEPLOY_SSH_USER }}
      SSH_KEY_FILE: ${{ runner.temp }}/deploy_key
    steps:
      - name: Download build artifact
        uses: actions/download-artifact@v4
        with:
          github-token: ${{ github.token }}
          repository: ${{ github.repository }}
          run-id: ${{ github.event.inputs.build_run_id }}
          name: dme-archival-workflow-artifacts
          path: artifacts

      - name: List downloaded artifacts
        shell: bash
        run: |
          set -euo pipefail
          echo "Downloaded artifacts:"
          find artifacts -maxdepth 4 -type f | sort

      - name: Resolve jar file
        id: jar
        shell: bash
        run: |
          set -euo pipefail
          jar_path="$(find artifacts -maxdepth 4 -type f -name 'dme-sync-*.jar' | sort | head -n 1)"
          if [ -z "$jar_path" ]; then
            echo "No dme-sync-*.jar artifact found" >&2
            exit 1
          fi

          jar_name="$(basename "$jar_path")"
          echo "jar_path=$jar_path" >> "$GITHUB_OUTPUT"
          echo "jar_name=$jar_name" >> "$GITHUB_OUTPUT"
          echo "Resolved jar: $jar_name"

      - name: Map server name to host
        id: host
        shell: bash
        run: |
          set -euo pipefail
          case "${{ matrix.server }}" in
            dev-app-01)
              host="dev-app-01.example.com"
              ;;
            dev-app-02)
              host="dev-app-02.example.com"
              ;;
            qa-app-01)
              host="qa-app-01.example.com"
              ;;
            *)
              echo "Unknown server label: ${{ matrix.server }}" >&2
              echo "Add it to the case statement in this workflow." >&2
              exit 1
              ;;
          esac

          echo "host=$host" >> "$GITHUB_OUTPUT"
          echo "Target host: $host"

      - name: Prepare SSH key
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "${{ secrets.DEPLOY_SSH_PRIVATE_KEY }}" > "$SSH_KEY_FILE"
          chmod 600 "$SSH_KEY_FILE"
          ssh-keyscan -H "${{ steps.host.outputs.host }}" >> ~/.ssh/known_hosts

      - name: Stop service and back up existing jar
        shell: bash
        run: |
          set -euo pipefail
          ssh -i "$SSH_KEY_FILE" -o IdentitiesOnly=yes "${SSH_USER}@${{ steps.host.outputs.host }}" "set -euo pipefail; sudo systemctl stop ${SERVICE_NAME}; cd ${DEPLOY_DIR}; find . -maxdepth 1 -type f -name '${APP_NAME}-*.jar' -exec mv {} {}_backup_\$(date +%Y%m%d.%H%M) \;; rm -f ${APP_NAME}.jar"

      - name: Copy new jar to server
        shell: bash
        run: |
          set -euo pipefail
          scp -i "$SSH_KEY_FILE" -o IdentitiesOnly=yes \
            "${{ steps.jar.outputs.jar_path }}" \
            "${SSH_USER}@${{ steps.host.outputs.host }}:${DEPLOY_DIR}/${{ steps.jar.outputs.jar_name }}"

      - name: Create symlink and start service
        shell: bash
        run: |
          set -euo pipefail
          ssh -i "$SSH_KEY_FILE" -o IdentitiesOnly=yes "${SSH_USER}@${{ steps.host.outputs.host }}" "set -euo pipefail; cd ${DEPLOY_DIR}; ln -sfn ${{ steps.jar.outputs.jar_name }} ${APP_NAME}.jar; sudo systemctl start ${SERVICE_NAME}"
